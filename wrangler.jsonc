{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dozokit-sites",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Reading a page the owner points at, or reaching their Dozokit Analytics, goes over the public internet.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Every address goes to the Worker first: the site at the top level, the builder under /admin.
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  // No ids: the Deploy button creates the database and the photo store.
  "d1_databases": [{ "binding": "DB", "database_name": "dozokit-sites", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "IMAGES" }],
  // A headless browser, so a chat app can see the page it designs (free plan: 10 minutes a day).
  "browser": { "binding": "BROWSER" },
  // namespace_id only has to be unique in your Cloudflare account: change it if it clashes.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "7411", "simple": { "limit": 5, "period": 60 } },
    { "name": "CONTACT_LIMIT", "namespace_id": "7412", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
